# Copy to .env and fill in. MOCK_LLM=1 needs no API key at all.

# --- LLM ---
# Groq API key. Only required when MOCK_LLM=0.
GROQ_API_KEY=
LLM_SMALL=llama-3.1-8b-instant
LLM_LARGE=llama-3.3-70b-versatile
MOCK_LLM=1

# --- Databases (compose service hostnames, see deploy/docker-compose.yml) ---
SHOP_DATABASE_URL=postgresql://aegis:aegis@shop-db:5432/shop
AEGIS_DATABASE_URL=postgresql://aegis:aegis@aegis-db:5433/aegis

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- OPA ---
OPA_URL=http://opa:8181

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
PROMETHEUS_URL=http://lgtm:9090
LOKI_URL=http://lgtm:3100
TEMPO_URL=http://lgtm:3200

# --- Toxiproxy ---
TOXIPROXY_URL=http://toxiproxy:8474

# --- Console ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/events
